+            "timeout /t 2 /nobreak >nul\r\n"
+            f'"{installer}" /SP- /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /CLOSEAPPLICATIONS\r\n'
+            'del "%~f0" >nul 2>&1\r\n',

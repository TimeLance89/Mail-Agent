+async def _finish_google_oauth(
+    *,
+    state: str | None,
+    code: str | None,
+    error: str | None,
+    error_description: str | None,
+) -> HTMLResponse:
+    if not state:
+        raise HTTPException(status_code=400, detail="Missing OAuth state")
